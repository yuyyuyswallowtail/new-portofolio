# --- Database (local docker-compose Postgres) ---
DIRECT_URL=postgres://portofolio:portofolio@localhost:5432/portofolio
DATABASE_URL=postgres://portofolio:portofolio@localhost:5432/portofolio
DATABASE_NAME=portofolio
DATABASE_USERNAME=portofolio
DATABASE_PASSWORD=portofolio

# --- Supabase (optional — only needed if you switch from local docker Postgres to Supabase) ---
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=

# --- Session / auth ---
SESSION_COOKIE_NAME=portofolio_session
SESSION_TTL_DAYS=7

# --- Bootstrap super admin (used once by `bun run seed:admin`) ---
ADMIN_EMAIL=bintangmsr@gmail.com
ADMIN_PASSWORD=20200410700101
ADMIN_NAME=Bintang Mesir

# --- Gemini (text generation: gemini-3.8-flash, image generation: gemini-3.1-flash-image (Nano Banana successor)) ---
# Get a free-tier key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Auto-generate articles (cron service in docker-compose.yml) ---
CRON_SECRET=change-this-to-a-random-string
CRON_SCHEDULE_HOURS=6
CRON_AUTO_PUBLISH=false
